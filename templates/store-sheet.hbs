<div class="cfer-store {{#if closed}}is-closed{{/if}}">

  <div class="cfer-store-header">
    <div class="cfer-store-title">
      <i class="fa-solid fa-store"></i>
      <h2>{{doc.name}}</h2>
      {{#if editable}}
        <button type="button" class="cfer-icon-btn" data-action="editField" data-field="name" title="Rename store"><i class="fa-solid fa-pen"></i></button>
      {{/if}}
      <span class="cfer-store-type-pill">{{typeLabel}}{{#if store.settlementSize}} · {{store.settlementSize}}{{/if}}{{#if store.level}} · Lv. {{store.level}}{{/if}}</span>
      {{#if closed}}<span class="cfer-store-closed-pill"><i class="fa-solid fa-door-closed"></i> Closed</span>{{/if}}
      {{#if priceMulLabel}}<span class="cfer-store-mul-pill" title="Price multiplier">{{priceMulLabel}} prices</span>{{/if}}
    </div>
    <div class="cfer-store-header-actions">
      <button type="button" data-action="toggleBrowser" class="{{#if browserOpen}}is-active{{/if}}" title="Browse the catalog — order items the store doesn't stock ({{orderFee}}% fee)">
        <i class="fa-solid fa-book-open"></i> Catalog
      </button>
      {{#if editable}}
        <button type="button" data-action="restock" title="Add 3 random type-appropriate items from the compendium">
          <i class="fa-solid fa-boxes-stacked"></i> Restock ×3
        </button>
        <button type="button" data-action="shareStore" title="Give players observer access and post a chat link">
          <i class="fa-solid fa-share-nodes"></i> Share
        </button>
        <button type="button" data-action="storeSettings" title="Prices, sell rate, open/closed">
          <i class="fa-solid fa-gear"></i>
        </button>
      {{/if}}
    </div>
  </div>

  {{#if store.description}}
    <div class="cfer-store-description">
      <p>{{store.description}}</p>
      {{#if editable}}
        <button type="button" class="cfer-icon-btn" data-action="editField" data-field="description" title="Edit description"><i class="fa-solid fa-pen"></i></button>
      {{/if}}
    </div>
  {{else if editable}}
    <div class="cfer-store-description cfer-store-description--empty">
      <button type="button" data-action="editField" data-field="description"><i class="fa-solid fa-pen"></i> Add a description</button>
    </div>
  {{/if}}

  {{#if store.owner}}
    <div class="cfer-store-owner" {{#if editable}}data-action="openOwnerNote" role="button" title="Edit shopkeeper · drop an Actor here to link"{{/if}}>
      {{#if ownerPortrait}}
        <img class="cfer-store-owner-portrait" src="{{ownerPortrait}}" alt="{{store.owner.name}}" />
      {{else}}
        <i class="fa-solid fa-user-tie"></i>
      {{/if}}
      <div class="cfer-store-owner-text">
        <strong>{{store.owner.name}}</strong>{{#if store.owner.ancestry}} <span class="cfer-muted">— {{store.owner.ancestry}}</span>{{/if}}
        {{#if store.owner.actorId}}
          <button type="button" class="cfer-icon-btn" data-action="openOwnerActor" title="Open linked actor"><i class="fa-solid fa-user"></i></button>
        {{/if}}
        {{#if store.owner.description}}<p>{{store.owner.description}}</p>{{/if}}
      </div>
    </div>
  {{else if editable}}
    <div class="cfer-store-owner cfer-store-owner--empty">
      <button type="button" data-action="openOwnerNote"><i class="fa-solid fa-user-plus"></i> Add a shopkeeper</button>
      <span class="cfer-drop-hint">…or drop an Actor here</span>
    </div>
  {{/if}}

  <div class="cfer-store-main {{#if browserOpen}}has-browser{{/if}}">

    <section class="cfer-store-inventory" aria-label="Store inventory">
      <div class="cfer-store-inventory-head">
        <h3><i class="fa-solid fa-shelves"></i> Inventory <span class="cfer-muted">({{itemCount}} in stock · {{lineCount}} goods)</span></h3>
        <span class="cfer-drop-hint">{{#if editable}}Drag items in to stock · drag rows out to hand over{{else}}Drop your own items here to sell{{/if}}</span>
      </div>

      {{#if groups.length}}
        {{#each groups}}
          <h4 class="cfer-store-group-label">{{this.label}}</h4>
          <ul class="cfer-store-rows">
            {{#each this.rows}}
              <li class="cfer-store-row" draggable="true" data-drag-uuid="{{this.uuid}}" data-uuid="{{this.uuid}}">
                <img src="{{this.img}}" alt="" class="cfer-store-row-img" />
                <a class="cfer-store-row-name" data-action="openItem">{{this.name}}</a>
                <span class="cfer-store-row-level" title="Item level">L{{this.level}}</span>
                {{#if ../../editable}}
                  <a class="cfer-store-row-price {{#if this.adjusted}}is-adjusted{{/if}}" data-action="editPrice" title="Click to set base price{{#if this.adjusted}} · base {{this.basePrice}}{{/if}}">{{this.displayPrice}}</a>
                {{else}}
                  <span class="cfer-store-row-price {{#if this.adjusted}}is-adjusted{{/if}}" {{#if this.adjusted}}title="Adjusted price"{{/if}}>{{this.displayPrice}}</span>
                {{/if}}
                <span class="cfer-store-row-qty">
                  {{#if ../../editable}}<button type="button" class="cfer-icon-btn" data-action="qtyDelta" data-delta="-1" title="Less stock">−</button>{{/if}}
                  ×{{this.qty}}
                  {{#if ../../editable}}<button type="button" class="cfer-icon-btn" data-action="qtyDelta" data-delta="1" title="More stock">+</button>{{/if}}
                </span>
                {{#if ../../canTrade}}
                  <button type="button" class="cfer-store-row-buy" data-action="buyItem" title="Buy this item"><i class="fa-solid fa-coins"></i> Buy</button>
                {{/if}}
                {{#if ../../editable}}
                  <button type="button" class="cfer-icon-btn cfer-store-row-remove" data-action="removeItem" title="Remove from store"><i class="fa-solid fa-trash"></i></button>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        {{/each}}
      {{else}}
        <p class="cfer-store-empty"><em>The shelves are bare.{{#if editable}} Drag items in, or use Compendium Stock / Restock.{{/if}}</em></p>
      {{/if}}

      {{#if orders.length}}
        <h4 class="cfer-store-group-label cfer-store-orders-label"><i class="fa-solid fa-scroll"></i> Special Orders</h4>
        <ul class="cfer-store-rows cfer-store-orders">
          {{#each orders}}
            <li class="cfer-store-row cfer-store-order-row {{#if this.isMine}}is-mine{{/if}}" data-order-id="{{this.id}}">
              <img src="{{this.img}}" alt="" class="cfer-store-row-img" />
              <span class="cfer-store-row-name">{{this.name}}</span>
              <span class="cfer-muted">for {{this.buyerName}}{{#if this.dateLabel}} · {{this.dateLabel}}{{/if}}</span>
              <span class="cfer-store-row-price">{{this.priceLabel}}</span>
              {{#if ../editable}}
                <button type="button" class="cfer-store-row-buy" data-action="deliverOrder" title="The order arrives — deliver it to the buyer"><i class="fa-solid fa-box-open"></i> Deliver</button>
                <button type="button" class="cfer-icon-btn" data-action="cancelOrder" title="Cancel and refund"><i class="fa-solid fa-rotate-left"></i></button>
              {{else}}
                <span class="cfer-store-order-status"><i class="fa-solid fa-hourglass-half"></i> on order</span>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      {{/if}}
    </section>

    {{#if browserOpen}}
      <aside class="cfer-store-browser" aria-label="Compendium browser">
        <div class="cfer-store-browser-head">
          <h3><i class="fa-solid fa-book-open"></i> {{typeLabel}} stock</h3>
        </div>
        <input type="search" data-browser-search placeholder="Search items…" value="{{browserSearch}}" />
        <div class="cfer-store-browser-filters">
          <select data-browser-source title="Item source">
            <option value="all">All compendiums</option>
            {{#each browserSources}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
          <label class="cfer-browser-filter"><input type="checkbox" data-browser-alltypes {{#if browserAllTypes}}checked{{/if}} /> All types</label>
          {{#if editable}}
            <button type="button" class="cfer-browser-wiki" data-action="fetchWiki" title="Fetch an item from the reference wiki and convert it (1 use)">
              <i class="fa-solid fa-globe"></i> Fetch from wiki
            </button>
          {{/if}}
          <label class="cfer-browser-filter">Max Lv <input type="number" data-browser-maxlevel min="0" max="30" value="{{browserMaxLevel}}" /></label>
        </div>
        <ul class="cfer-store-rows cfer-store-browser-rows">
          {{#each browserRows}}
            {{#if this.wiki}}
            <li class="cfer-store-row cfer-store-row--wiki" data-item-name="{{this.name}}">
              <img src="{{this.img}}" alt="" class="cfer-store-row-img" />
              <span class="cfer-store-row-name" title="{{this.packLabel}}">{{this.name}}</span>
              <span class="cfer-store-row-level">L{{this.level}}</span>
              <span class="cfer-store-row-price">{{this.price}}</span>
              {{#if ../editable}}
                <button type="button" class="cfer-icon-btn" data-action="importWikiRow" title="Convert from the wiki and stock (1 use)"><i class="fa-solid fa-download"></i></button>
              {{/if}}
            </li>
            {{else}}
            <li class="cfer-store-row" draggable="true" data-drag-uuid="{{this.uuid}}" data-browser-uuid="{{this.uuid}}" data-price-cp="{{this.priceCp}}" data-item-name="{{this.name}}">
              <img src="{{this.img}}" alt="" class="cfer-store-row-img" />
              <span class="cfer-store-row-name" title="{{this.packLabel}}">{{this.name}}</span>
              <span class="cfer-store-row-level">L{{this.level}}</span>
              <span class="cfer-store-row-price">{{this.price}}</span>
              {{#if ../canTrade}}
                <button type="button" class="cfer-icon-btn" data-action="orderItem" title="Special-order this item ({{../orderFee}}% fee, paid in advance)"><i class="fa-solid fa-scroll"></i></button>
              {{/if}}
              {{#if ../editable}}
                <button type="button" class="cfer-icon-btn" data-action="addFromBrowser" title="Add to stock now"><i class="fa-solid fa-plus"></i></button>
              {{/if}}
            </li>
            {{/if}}
          {{else}}
            <li class="cfer-store-empty"><em>No matching items.</em></li>
          {{/each}}
        </ul>
      </aside>
    {{/if}}

  </div>
</div>
